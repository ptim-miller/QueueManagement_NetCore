@model Encounter

@{
    ViewBag.Title = "Patient Notification";
    if (Model.status == Status.waiting)
    {
        @:<h3>Patient Notification </h3>
        <h5>
            Sending a notification will automatically change the status to <b><u>Notified</u></b>. Upon patient
            arrival, manually change patient status to <b><u>Arrived</u></b> through the Edit patient link.
        </h5>
    }
    else if (Model.status == Status.arrived)
    {
        @:<h3>Patient Notification </h3>
        <h5>Sending a notification will automatically change the status to <b><u>Finished</u></b>.</h5>
    }
}

<div class="row">

    <form method="post">
        <div asp-validation-summary="All" class="text-danger"></div>
        <input type="hidden" asp-for="id" />
        <div class="col-md-2">
            <div class="form-group">
                <div class="form-group">
                    @Html.LabelFor(model => model.patient.FHIR_id, htmlAttributes: new { @class = "control-label" })
                    <div class="col-md-15">
                        @Html.DisplayFor(model => model.patient.FHIR_id, new { htmlAttributes = new { @class = "form-control" } })
                    </div>
                </div>
                <div class="form-group">
                    @Html.LabelFor(model => model.patient.lastname, htmlAttributes: new { @class = "control-label" })
                    <div class="col-md-15">
                        @Html.DisplayFor(model => model.patient.lastname, new { htmlAttributes = new { @class = "form-control" } })
                    </div>
                </div>
                <div class="form-group">
                    @Html.LabelFor(model => model.patient.firstname, htmlAttributes: new { @class = "control-label" })
                    <div class="col-md-15">
                        @Html.DisplayFor(model => model.patient.firstname, new { htmlAttributes = new { @class = "form-control" } })
                    </div>
                </div>
                <div class="form-group">
                        @Html.LabelFor(model => model.status, htmlAttributes: new { @class = "control-label" })
                        <div class="col-md-15">
                            @Html.DisplayFor(model => model.status, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.status, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(model => model.start, htmlAttributes: new { @class = "control-label" })
                        <div class="col-md-15">
                            @Html.DisplayFor(model => model.start, new { htmlAttributes = new { @class = "form-control" } })
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(model => model.patient.email, htmlAttributes: new { @class = "control-label" })
                        <div class="col-md-15">
                            @Html.DisplayFor(model => model.patient.email, new { htmlAttributes = new { @class = "form-control" } })
                        </div>
                    </div>
                <br />
            </div>
        </div>
        <div class="form-group">
            <div>
                @Html.TextArea("message", new { @class = "form-control messagearea" })
            </div>
        </div>
        
        <div class="form-group">
            <div>
                <input type="submit" value="Send Ready Message" class="btn btn-success" />
            </div>
        </div>
        @ViewBag.failed
    </form>
</div>