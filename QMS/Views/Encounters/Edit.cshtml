@model QMS.Models.Encounter

@{
    ViewData["Title"] = "Edit";
}

<h4>Encounter Status</h4>

@if (Model.end.HasValue)
{
    <div class="row">
        <div class="col-md-2">
            @Html.ActionLink("Create New Visit", "CreateIdentity", "Patients", new { newPatient = false }, new { @class = "btn btn-success pull-left" })
        </div>
    </div>
}

<hr />
<div class="row">
    <div class="col-md-2">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="id" />

            <div class="form-group">
                @Html.LabelFor(model => model.patient.FHIR_id, htmlAttributes: new { @class = "control-label" })
                <div>
                    @Html.DisplayFor(model => model.patient.FHIR_id, new { htmlAttributes = new { @class = "form-control" } })
                </div>
            </div>
            <div class="form-group">
                @Html.LabelFor(model => model.patient.lastname, htmlAttributes: new { @class = "control-label" })
                <div class="col-md-15">
                    @Html.DisplayFor(model => model.patient.lastname, new { htmlAttributes = new { @class = "form-control" } })
                </div>
            </div>
            <div class="form-group">
                @Html.LabelFor(model => model.patient.firstname, htmlAttributes: new { @class = "control-label" })
                <div class="col-md-15">
                    @Html.DisplayFor(model => model.patient.firstname, new { htmlAttributes = new { @class = "form-control" } })
                </div>
            </div>
            <div class="form-group">
                @Html.LabelFor(model => model.start, htmlAttributes: new { @class = "control-label" })
                <div class="col-md-15">
                    @Html.DisplayFor(model => model.start, new { htmlAttributes = new { @class = "form-control" } })
                </div>
            </div>
            @if (Model.end.HasValue)
            {
                <div class="form-group">
                    @Html.LabelFor(model => model.end, htmlAttributes: new { @class = "control-label" })
                    <div class="col-md-15">
                        @Html.DisplayFor(model => model.end, new { htmlAttributes = new { @class = "form-control" } })
                    </div>
                </div>
            }

            <div class="form-group">
                <label asp-for="status"></label>
                <div class="col-md-15">
                    @Html.DropDownListFor(model => model.status, @Html.GetEnumSelectList(typeof(Status)))
                    <span asp-validation-for="status" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-success pull-left" />
            </div>
            <hr />
        </form>
    </div>
</div>

<br />
<div>
    <a asp-action="Index" class="btn btn-sm btn-success">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}


























