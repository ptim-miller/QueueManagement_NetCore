@{
    ViewBag.Title = "Walkin Center";
}

<h2>Would you like to be seen at the Walk-In Center?</h2>

<div class="row">
    <div class="col-md-1">
    </div>
    <div class="col-md-4">
        <form method="post">
            <div class="form-group">
                <a asp-action=WalkinDirections class="btn btn-success btn-sm">Yes</a>
                <a asp-action=Insurance class="btn btn-success btn-sm">No</a>
            </div>
        </form>
    </div>
</div>

<hr />
<a asp-action=Complaint class="btn btn-success btn-sm">Back</a>
<a asp-action=Start class="btn btn-success btn-sm">Reset</a>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
