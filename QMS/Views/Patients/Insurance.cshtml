@model InsuranceView

@{
    ViewBag.Title = "Insurance Information";
}
<h2>Please enter your insurance information</h2>

<div class="row">
    <div class="col-md-1">
    </div>
    <div class="col-md-4">
        <form method="post">
            <hr />
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="provider"></label>
                <input asp-for="provider" class="form-control" />
                <span asp-validation-for="provider" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="policy"></label>
                <input asp-for="policy" class="form-control" />
                <span asp-validation-for="policy" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="primary"></label>
                <input asp-for="primary" class="form-control" />
                <span asp-validation-for="primary" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="primaryName"></label>
                <input asp-for="primaryName" class="form-control" />
                <span asp-validation-for="primaryName" class="text-danger"></span>
            </div>

            <hr />
            <button type="submit" class="btn btn-success btn-lg">Next</button>
        </form>
    </div>
</div>

<hr />
<a asp-action=Walkin asp-route-newPatient=false class="btn btn-success btn-sm">Back</a>
<a asp-action=Start class="btn btn-success btn-sm">Reset</a>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}

