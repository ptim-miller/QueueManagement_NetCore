@model ComplaintView

@{
    ViewBag.Title = "Complaint";
}
<script>
    function needHelp(e) {
        
        if (e.checked) {
            alert('Press reset below and proceed to the ER desk immediately')
            document.getElementById("next").style.display = 'none'
            document.getElementById("threatwarning").style.display = 'block'
        }
        else {
            document.getElementById("next").style.display = 'block'
            document.getElementById("threatwarning").style.display = 'none'

        }
    }
</script>
<h2>What is the main reason for your visit today?</h2>

<div class="row">
    <div class="col-md-1">
    </div>
    <div class="col-md-4">
        <form method="post">
            <hr />
            <div asp-validation-summary="All" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="lifethreatening"></label>
                <div class="col-md-10">
                    <input asp-for="lifethreatening" class="form-control" onchange="javascript:needHelp(this);"/>
                    <span asp-validation-for="lifethreatening" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="complaint"></label>
                <textarea asp-for="complaint" class="form-control" rows="5" maxlength="500" draggable="false" > </textarea>
                <span asp-validation-for="complaint" class="text-danger"></span>
            </div>

            <hr />
            <div id="threatwarning">
                <h2>Press reset below and proceed to the ER desk immediately!</h2>
            </div>
            <button id="next" type="submit" class="btn btn-success btn-lg">Next</button>
        </form>
    </div>
</div>

<hr />
<a asp-action=Contact asp-route-newPatient=false class="btn btn-success btn-sm">Back</a>
<a asp-action=Start class="btn btn-success btn-sm">Reset</a>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}


