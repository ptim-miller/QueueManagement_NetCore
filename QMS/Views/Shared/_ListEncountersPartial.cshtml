@model IEnumerable<Encounter>

<h3>Patient List</h3>

<div class="table-responsive">
    <table class="table table-striped table-bordered table-condensed">
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.patient.FHIR_id)
            </th>
            <th>
                @Html.Label("Patient")
            </th>
            <th>
                @Html.DisplayNameFor(model => model.status)
            </th>
            <th>
                @Html.Label("Minutes in Status")
            </th>
            <th>
                @Html.DisplayNameFor(model => model.start)
            </th>
            @if (ViewBag.showEnd == true)
            {
                <th>
                    @Html.DisplayNameFor(model => model.end)
                </th>
            }
            <th></th>
        </tr>
        @if (Model.Count() > 0)
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.patient.FHIR_id)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.patient.lastname),   @Html.DisplayFor(modelItem => item.patient.firstname)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.status)
                    </td>
                    <td>
                        @if (item.end == null)
                    {
                            @Convert.ToInt32(DateTime.Now.Subtract(item.start).TotalMinutes)
                        }
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.start)
                    </td>
                    @if (ViewBag.showEnd == true)
                    {
                        <td>
                            @Html.DisplayFor(modelItem => item.end)
                        </td>
                    }
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.id" class="btn btn-sm btn-xs btn-success">Edit</a>
                        <a asp-action="Details" asp-route-id="@item.id" class="btn btn-sm btn-xs btn-success">Info</a>
                        @*<a asp-action="Delete" asp-route-id="@item.id" class="btn btn-sm btn-xs btn-success">Delete</a>*@

                        @if (item.status == Status.waiting || item.status == Status.arrived)
                    {
                            <a asp-action="Notify" asp-route-id="@item.id" class="btn btn-sm btn-xs btn-success">Msg</a>
                        }
                    </td>
                </tr>
            }
        }
    </table>
</div>

